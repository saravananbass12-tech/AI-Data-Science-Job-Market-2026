		lineageTag: d70ddf83-1803-4e20-a7a8-1a97a1f1dfde

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'AI Users' =
			
			CALCULATE(
			    [Total Jobs],
			    AI_Jobs_2026[uses_ai_tools_daily] = TRUE()
			)
		formatString: 0
		lineageTag: 215b3048-fdeb-417d-9444-19754bbdd52f

	measure 'AI Usage %' =
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(AI_Jobs_2026),
			        AI_Jobs_2026[uses_ai_tools_daily] = TRUE()
			    ),
			    COUNTROWS(AI_Jobs_2026),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e7e8880d-ab05-4c46-b0ac-227703f843aa

	measure 'Jobs Switched' =
			
			CALCULATE(
			    [Total Jobs],
			    AI_Jobs_2026[switched_jobs_last_year] = TRUE()
			)
		formatString: 0
		lineageTag: da48a21b-f897-4b58-840a-49738944d629

	measure 'Job Switch %' =
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(AI_Jobs_2026),
			        AI_Jobs_2026[switched_jobs_last_year] = TRUE()
			    ),
			    COUNTROWS(AI_Jobs_2026),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b747e064-cd10-4e85-b600-ca6b039e8795

	measure 'Average AI Hours' =
			

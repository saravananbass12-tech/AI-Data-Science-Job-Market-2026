		formatString: 0.00
		lineageTag: 24bb10cf-1aee-4262-a3b6-773bc6938676

	measure 'Salary Distribution %' =
			
			DIVIDE(
			    COUNTROWS(AI_Jobs_2026),
			    CALCULATE(
			        COUNTROWS(AI_Jobs_2026),
			        REMOVEFILTERS(AI_Jobs_2026[salary_usd (bins)])
			    ),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 91924e3f-b8e8-4e46-bb4c-ee68222d5ac6

	measure 'Upskilling Hours %' =
			
			DIVIDE(
			    COUNTROWS(AI_Jobs_2026),
			    CALCULATE(
			        COUNTROWS(AI_Jobs_2026),
			        ALL(AI_Jobs_2026[Upskilling Hours Category])
			    ),
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: a49e2410-433d-4672-88f5-2ec11e799fff


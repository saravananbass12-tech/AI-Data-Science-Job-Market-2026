	column 'Remote Work Type' =
			
			SWITCH(
			    AI_Jobs_2026[remote_ratio],
			    0, "On-site",
			    50, "Hybrid",
			    100, "Fully Remote",
			    "Other"
			)
		lineageTag: 580157e7-3fd3-498b-b13d-35494f292cf8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Company Size Full' =
			
			SWITCH(
			    'AI_Jobs_2026'[company_size],
			    "S", "Small",
			    "M", "Medium",
			    "L", "Large",
			    "Unknown"
			)
		lineageTag: 266c6a7c-bab3-4a5f-a1d8-14f5b5516d7d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Satisfaction Category' =
			
			SWITCH(
			    TRUE(),
			    AI_Jobs_2026[job_satisfaction_score] >= 8, "Very Satisfied",
			    AI_Jobs_2026[job_satisfaction_score] >= 6, "Satisfied",
			    AI_Jobs_2026[job_satisfaction_score] >= 4, "Neutral",
			    "Dissatisfied"
			)
		lineageTag: 4767a4dc-ab2d-41d1-9bea-ae52a105a605
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Company Country' =
			

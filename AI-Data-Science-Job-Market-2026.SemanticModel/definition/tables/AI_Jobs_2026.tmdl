table AI_Jobs_2026
	lineageTag: ba847a27-1227-46a3-9a10-34431de9745a

	measure 'Total Jobs' =
			
			COUNTROWS(AI_Jobs_2026)
		formatString: 0
		lineageTag: 10f440a8-d4f0-4267-8280-9eac2b8dad3b

	measure 'Average Salary' =
			
			AVERAGE(AI_Jobs_2026[salary_usd])
		lineageTag: 1e42f293-5bff-4bf1-b5f2-c46fa4435496

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Highest Salary' =
			
			MAX(AI_Jobs_2026[salary_usd])
		formatString: 0
		lineageTag: ad9b72d9-46ec-4643-aa0e-055bef1ec183

	measure 'Minimum Salary' =
			
			MIN(AI_Jobs_2026[salary_usd])
		formatString: 0
		lineageTag: ba863faf-a2a3-4605-901e-1d92936715fc

	measure 'Median Salary' =
			
